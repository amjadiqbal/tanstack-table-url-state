{
  "name": "@amjadiqbal/tanstack-table-url-state",
  "version": "0.1.0",
  "description": "URL state (sorting, filters, pagination, column visibility) and CSV/XLSX export for TanStack Table v9.",
  "license": "MIT",
  "author": "Amjad Iqbal (https://amjad.com.pk)",
  "homepage": "https://github.com/amjadiqbal/tanstack-table-url-state#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amjadiqbal/tanstack-table-url-state.git"
  },
  "bugs": "https://github.com/amjadiqbal/tanstack-table-url-state/issues",
  "keywords": [
    "tanstack",
    "tanstack-table",
    "react-table",
    "url-state",
    "search-params",
    "tanstack-router",
    "csv",
    "xlsx",
    "react"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./router": {
      "types": "./dist/router.d.ts",
      "import": "./dist/router.js"
    },
    "./csv": {
      "types": "./dist/csv.d.ts",
      "import": "./dist/csv.js"
    },
    "./xlsx": {
      "types": "./dist/xlsx.d.ts",
      "import": "./dist/xlsx.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "ci": "bash scripts/ci-local.sh"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  },
  "peerDependencies": {
    "@tanstack/react-router": ">=1.120.0",
    "@tanstack/react-table": ">=9.0.0 <10",
    "react": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/react-table": "^9.3.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "jsdom": "^30.1.3",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-router": {
      "optional": true
    }
  }
}
